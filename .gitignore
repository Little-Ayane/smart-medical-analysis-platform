# ===== Python 虚拟环境 =====
.venv/
venv/
env/
ENV/

# ===== Python 缓存 / 编译产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== 打包 / 分发 =====
build/
dist/
*.egg-info/
.eggs/

# ===== 大数据原始数据（不提交 200 万条住院记录）=====
data/
*.tsv
*.csv
*.db
*.sqlite
*.sqlite3

# ===== 环境变量 / 密钥（绝对禁止提交真实 Key） =====
# P4 AI 交互模块：本地 .env / .env.local 等都不提交，
# 仅保留 .env.production（不含真实密钥的模板）与 .env.example
.env
.env.local
.env.development
.env.test
.env.staging
.env.secret
.env.*.bak
.env.*.old
# 仅允许模板文件被提交（显式例外）
# !.env.example
# !.env.production   # 模板文件允许提交（由 P4 需要，默认就允许，这里只是注释说明）

# ===== 日志 =====
*.log
logs/

# ===== 系统 / IDE =====
.DS_Store
Thumbs.db
.idea/
*.swp
