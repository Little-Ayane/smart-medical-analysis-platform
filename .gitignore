# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# ===== 环境变量 / 密钥（绝对禁止提交真实 Key）=====
# 只允许提交不含密钥的 .env.example 模板；其余 .env* 一律忽略
.env
.env.local
.env.development
.env.test
.env.staging
.env.production
.env.secret
.env.*.bak
!.env.example

# ===== 日志 / 缓存 / 测试 =====
*.log
logs/
.pytest_cache/
.coverage
htmlcov/

# ===== 前端 / Node（node_modules 用 npm install 重建，不入库）=====
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===== 数据文件（大 dump 不入库；database/ 下的建表/索引/回填脚本保留）=====
*.csv
*.sql
!database/*.sql

# ===== IDE / OS =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== 临时目录 =====
tmp/
temp/
