# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=medical_db

# Hive 配置
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=root
HIVE_DATABASE=default
HIVE_AUTH=NONE

# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 应用配置
APP_DEBUG=true
APP_PORT=8000
LOG_LEVEL=INFO
DATA_SOURCE=mysql
