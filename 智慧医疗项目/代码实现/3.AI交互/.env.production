# ============================================================
# P4 · AI 智能交互 - 生产环境配置模板
# 使用方法：
#   1) 复制本文件为 .env.local（本地开发）或 .env（生产），再填入真实值
#   2) Windows 启动：双击 start.bat，或 PowerShell: .\start.ps1
#   3) Linux/Mac 启动：./start.sh
#   4) 生产推荐：直接通过 Kubernetes Secret / systemd EnvironmentFile 注入，
#      不落地真实密钥文件（更安全）
# ============================================================
# ⚠️  不要把带真实密钥的 .env / .env.local 提交到 Git！
#     本项目已配置 .gitignore 自动忽略以下文件：
#     .env / .env.local / .env.production / .env.secret

# ====================== 基础服务（必填） ======================

# LLM API Key：从 https://cloud.siliconflow.cn 控制台获取（OpenAI 兼容接口）
# 例：LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_KEY=sk-acmhbtwzcblmerlwozpletfxkuxdeiaxsepwmbtyrhfnsyym

# P3 分析服务地址（不要 / 结尾，P4 会拼接 /analysis/xxx）
# 如果 P3 和 P4 部署在同一台机器默认即可；否则改成内网 DNS/Service 名
ANALYSIS_API=http://127.0.0.1:5000/api/v1

# P4 监听端口
P4_PORT=5001

# ====================== LLM 模型（可选） ======================

# 大模型：摘要/报告生成，默认 Qwen2.5-72B（质量最高）
LLM_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# 小模型：意图解析/参数审查，用 7B 速度更快更省 token（留空=复用大模型）
LLM_MODEL_ID_SMALL=Qwen/Qwen2.5-7B-Instruct

# LLM 基础地址（硅基流动默认 https://api.siliconflow.cn/v1，其他供应商改这里）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# ====================== 安全（可选，生产建议修改） ======================

# 生产必须设为 0，调试时才开 1
FLASK_DEBUG=0

# CORS 白名单（逗号分隔多个域名），只允许 P5 前端所在地址
# 本地开发默认 http://localhost:3000,http://127.0.0.1:3000
# 生产示例：CORS_ORIGINS=https://your-hospital.com,https://admin.your-hospital.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====================== 会话存储（生产强烈建议用 Redis） ======================

# memory（默认，单机重启会丢） / redis（持久化 + 横向扩展）
SESSION_BACKEND=redis
#memory

# Redis 连接串（当 SESSION_BACKEND=redis 才使用）
# 格式：redis://:password@host:port/db_number
# 无密码示例：REDIS_URL=redis://10.0.0.12:6379/3
REDIS_URL=redis://127.0.0.1:6379/0

# 会话存活时间（默认 2 小时，超时用户要重新发起对话）
SESSION_TTL_SECONDS=7200

# Redis 连不上后多久才再重试下一次（避免每次都卡 2s，默认 5s）
REDIS_RETRY_COOLDOWN=5
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# ====================== 缓存（可选，默认够用） ======================

INTENT_CACHE_ENABLED=1
INTENT_CACHE_TTL_SECONDS=600

# ====================== 异步报告（可选） ======================

# 后台线程池大小（默认 4，高并发部署可设 8~32）
ASYNC_REPORT_WORKERS=4

# 报告结果在内存中保留时间（默认 1h，避免不查询的报告永远占内存）
ASYNC_REPORT_TTL_SECONDS=3600
