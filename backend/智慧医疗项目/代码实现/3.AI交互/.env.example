# ============================================================
# P4 AI 智能交互服务 · 环境变量模板
# 使用方法：
#   1) 复制本文件为 .env / .env.local / .env.production（任选其一）
#   2) 填入真实的 LLM_API_KEY / LLM_BASE_URL 等值
#   3) 启动：./start.sh
# 安全：真实密钥绝不提交到 Git（.env* 已在 .gitignore 中忽略）。
# ============================================================

# ---- LLM 模型（OpenAI 兼容接口）----
# 必填：你的 API Key（示例为占位，替换成真实值）
LLM_API_KEY=
# 必填：OpenAI 兼容接口地址
LLM_BASE_URL=https://api.example.com/v1

# 模型 ID：摘要/报告生成（默认文本模型）
LLM_MODEL_ID=
# 模型 ID：工具调用 / function-calling（推理增强）
LLM_MODEL_ID_AGENT=
# 模型 ID：意图解析 / 参数审查（小模型，可复用默认模型）
LLM_MODEL_ID_SMALL=

# 工具调用失败重试次数
AGENT_TOOL_RETRIES=2

# ---- LLM 请求参数 ----
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3

# ---- P4 服务 ----
# P3 分析服务地址（不要以 / 结尾）
ANALYSIS_API=http://127.0.0.1:5000
P4_PORT=5001
FLASK_DEBUG=false
# 跨域来源（逗号分隔，* 表示全部）
CORS_ORIGINS=*

# ---- 会话 / 缓存 ----
# 会话后端：memory（进程内，重启丢失）或 redis（跨重启持久）
SESSION_BACKEND=memory
# Redis 连接（SESSION_BACKEND=redis 时使用）
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=3600
REDIS_RETRY_COOLDOWN=60
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# ---- 意图缓存 ----
INTENT_CACHE_ENABLED=true
INTENT_CACHE_TTL_SECONDS=300

# ---- 异步报告 ----
ASYNC_REPORT_WORKERS=2
ASYNC_REPORT_TTL_SECONDS=3600
