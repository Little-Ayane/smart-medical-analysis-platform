# ============================================================
# core/drg FastAPI 服务环境变量模板（复制为 .env 后按需修改）
# 读取方：fastapi_common/database.py（MYSQL/HIVE/REDIS/APP 四组）
# ============================================================

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=medical_db

# ---- Hive（可选，DATA_SOURCE=hive 时使用）----
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=root
HIVE_DATABASE=default
HIVE_AUTH=NONE

# ---- Redis（可选）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 应用 ----
APP_DEBUG=true
APP_PORT=8000
LOG_LEVEL=INFO
DATA_SOURCE=mysql
